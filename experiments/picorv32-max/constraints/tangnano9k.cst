// Board: Sipeed Tang Nano 9K
// Part: GW1NR-LV9QN88PC6/I5; Apicula family: GW1N-9C.
// Pin assignments checked against Apicula 0.10.0 examples/tangnano9k.cst.
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;

// UART pins verified against the pinned official PicoTiny constraints.
IO_LOC "ser_tx" 17;
IO_PORT "ser_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "ser_rx" 18;
IO_PORT "ser_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
